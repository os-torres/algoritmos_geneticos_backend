# ============================================================
#  Plantilla de configuración — HorarioGenetico AI Service
#  Copia este archivo a .env (producción) o .env.local (desarrollo)
#  y ajusta los valores según tu entorno.
# ============================================================

# Entorno: "production" → deshabilita Swagger/ReDoc, restringe CORS
#          "development" → habilita Swagger, permite todos los orígenes
ENVIRONMENT=development

# Puerto donde escucha uvicorn
# En IIS este valor es inyectado automáticamente por HttpPlatformHandler
# mediante %HTTP_PLATFORM_PORT%; no es necesario configurarlo en .env del servidor.
AI_SERVICE_PORT=8000

# Ruta raíz en IIS (debe coincidir con el nombre del sitio/aplicación IIS)
# Dejar vacío en desarrollo local.
# Ejemplo producción: /HorarioGenetico
ROOT_PATH=/HorarioGenetico

# Nombre de la aplicación (informativo)
APP_NAME=HorarioGenetico

# Orígenes CORS permitidos, separados por coma.
# En producción: URL(s) exactas del frontend (sin trailing slash).
# En desarrollo: dejar vacío para permitir cualquier origen (*).
# Ejemplo: https://tuuniversidad.edu.co,https://horarios.tuuniversidad.edu.co
CORS_ORIGINS=

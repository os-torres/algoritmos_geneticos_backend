<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS HttpPlatformHandler — HorarioGenetico AI Service
  Adaptado del patrón usado en AppClasificacionGiecomAI (Giecom).

  IMPORTANTE: ajusta la ruta de processPath al path real de uvicorn.exe
  dentro del venv que crees en el servidor Windows.
  Por convención el proyecto se despliega en:
    C:\inetpub\wwwroot\HorarioGenetico\

  Pasos rápidos:
    1. Instala IIS + HttpPlatformHandler (ver DEPLOY.md)
    2. Copia el proyecto a C:\inetpub\wwwroot\HorarioGenetico\
    3. Crea el venv: python -m venv venv
    4. Instala dependencias: venv\Scripts\pip install -r requirements.txt
    5. Crea C:\inetpub\wwwroot\HorarioGenetico\logs\ (IIS escribe aquí)
    6. Configura el Application Pool sin tiempo de idle-timeout
    7. Recicla el App Pool o reinicia el sitio IIS
-->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="httpPlatformHandler" />
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform
        processPath="C:\inetpub\wwwroot\HorarioGenetico\venv\Scripts\uvicorn.exe"
        arguments="api:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --root-path /HorarioGenetico"
        stdoutLogEnabled="true"
        stdoutLogFile=".\logs\uvicorn"
        startupTimeLimit="120"
        requestTimeout="00:10:00">
      <environmentVariables>
        <environmentVariable name="ENVIRONMENT"  value="production" />
        <environmentVariable name="PYTHONPATH"   value="C:\inetpub\wwwroot\HorarioGenetico" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
